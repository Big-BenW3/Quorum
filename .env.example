# Quorum configuration. Copy to .env.local for development (or run `npm run setup`, which generates
# one with fresh secrets). In production set these in your host's environment, never in a file.
# Every value is validated at first use; a missing or weak production setting stops the app with a
# message that names the variable (never its value). See docs/deployment.md.

# ── Core ────────────────────────────────────────────────────────────────────────────────────────
APP_NAME="Quorum"
# Public origin of the app, no trailing slash. Used for links in emails, signed URLs and the origin (CSRF) check.
APP_URL="http://localhost:3000"
# Extra browser origins allowed to make state-changing requests (comma separated). Usually empty.
# ALLOWED_ORIGINS=""
# Set true when running behind a proxy that overwrites x-forwarded-for / x-real-ip. Defaults to true on Vercel.
# TRUST_PROXY_HEADERS=false

# ── Database ────────────────────────────────────────────────────────────────────────────────────
# Today: SQLite file (development only; production refuses it unless ALLOW_SQLITE_IN_PRODUCTION=true,
# which is only sensible on a single long-lived VM with a persistent disk).
DATABASE_URL="file:./.data/dev.db"
# ALLOW_SQLITE_IN_PRODUCTION=false
# Later (Neon / any PostgreSQL), see docs/deployment.md for the full switch:
#   DATABASE_URL="postgresql://app_user:...@ep-xxxx-pooler.region.aws.neon.tech/quorum?sslmode=require"   # pooled
#   DIRECT_URL="postgresql://owner:...@ep-xxxx.region.aws.neon.tech/quorum?sslmode=require"               # migrations only

# ── Secrets (generate with: openssl rand -base64 48) ─────────────────────────────────────────────
# Both must be at least 32 characters and differ from each other. In production these two are rejected
# while they still look like the "change-me" placeholders, so a copied file cannot go live by accident.
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-48"
# Root of every derived key (roster lookups, credential hashes, sealed labels, signed URLs).
# Rotating it invalidates roster lookups and sealed labels: do not rotate while an election is scheduled or open.
APP_SECRET="change-me-too-use-a-different-random-value-here"
# Required in production. Protects /api/jobs/sweep (Vercel cron sends it as a bearer token).
CRON_SECRET="change-me-cron-secret"

# ── Email (sign-up verification, password reset) ─────────────────────────────────────────────────
# none    : no mail is sent. Password reset is unavailable; email verification is off.
# console : prints the message to the server log (development only).
# resend  : sends through Resend and turns on required email verification.
MAIL_DRIVER="console"
# MAIL_FROM="Quorum <no-reply@your-domain.org>"
# RESEND_API_KEY=""

# ── File storage (roster uploads, banner and candidate images) ───────────────────────────────────
# none  : upload features answer 503 (CSV paste / manual entry still work).
# local : development only. Files under STORAGE_LOCAL_DIR, served through signed, expiring URLs.
# s3    : any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO). Bucket must be PRIVATE.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # omit for AWS S3
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false

# ── Rate limiting ────────────────────────────────────────────────────────────────────────────────
# database : counters in the app database (works on serverless, no Redis). Default.
# memory   : single process only; refused in production.
# none     : every rate-limited endpoint answers 503 (fails closed; it never runs unprotected).
RATE_LIMIT_DRIVER="database"
# VERIFY_PER_IP_PER_10MIN=30
# VERIFY_FAILS_PER_IDENTITY_PER_15MIN=6
# SUBMIT_PER_IP_PER_10MIN=30
# OPEN_ISSUE_PER_IP_PER_HOUR=10

# ── Background jobs ──────────────────────────────────────────────────────────────────────────────
# inline : parse roster files inside the request. Fine for small rosters (INLINE_PARSE_MAX_ROWS).
# qstash : durable queue (Upstash QStash). Large PDFs / OCR belong here.
JOB_DRIVER="inline"
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""

# ── Document extraction (PDF, DOCX, PNG, JPEG rosters) ───────────────────────────────────────────
# none : those formats are refused with a clear message; CSV and manual entry still work.
# http : sends the file to your own endpoint (contract in src/server/adapters/ocr.ts). This shares voter data
#        with a third-party processor: enable it deliberately and disclose it to your voters.
OCR_DRIVER="none"
# OCR_ENDPOINT_URL="https://ocr.your-domain.org/extract"
# OCR_API_KEY=""
# OCR_TIMEOUT_MS=30000

# ── Limits and retention (defaults shown) ────────────────────────────────────────────────────────
# MAX_ROSTER_BYTES=5000000
# MAX_ROSTER_ROWS=20000
# MAX_IMAGE_BYTES=2000000
# INLINE_PARSE_MAX_ROWS=5000
# CREDENTIAL_RETENTION_HOURS=24
# RAW_UPLOAD_RETENTION_HOURS=24
